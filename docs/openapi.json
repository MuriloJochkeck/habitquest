    "/habits/{habit_id}/checkins/today": {
      "parameters": [
        {
          "name": "habit_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          }
        }
      ],
      "put": {
        "summary": "Atualizar progresso absoluto de hoje",
        "operationId": "put_habits_habit_id_checkins_today",
        "responses": {
          "201": {
            "description": "Registrar realização do dia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckinResult"
                }
              }
            }
          },
          "404": {
            "description": "Hábito não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "error.code = habit_archived ou day_changed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Banco indisponível; error.code = database_unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado; mensagem genérica, detalhes apenas no log local.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Progresso atualizado ou conclusão já existente; nenhuma nova conclusão criada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckinResult"
                }
              }
            }
          },
          "422": {
            "description": "Quantidade inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "JSON inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Envie application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Habit-Date",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "description": "Data exibida pelo dashboard. Se divergir do dia atual em São Paulo, retorna 409 day_changed sem gravar. Ausente: usa o dia atual do servidor."
          }
        ],
        "description": "Sem corpo, conclui daily_target. Com corpo, substitui a quantidade absoluta de hoje. Valores abaixo da meta são progresso parcial e não geram XP. Concluir concede 10 XP e 50 XP ao atingir a meta semanal. Reduzir abaixo da meta reverte a conclusão, XP diário e bônus semanal quando aplicável, recalculando conquistas. Repetições são idempotentes. Datas calculadas pela API em São Paulo.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quantity": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000
                  }
                },
                "required": [
                  "quantity"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Desfazer a realização e zerar o progresso de hoje",
        "operationId": "delete_habits_habit_id_checkins_today",
        "responses": {
          "404": {
            "description": "Hábito não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "error.code = habit_archived ou day_changed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Banco indisponível; error.code = database_unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado; mensagem genérica, detalhes apenas no log local.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Progresso atualizado ou conclusão já existente; nenhuma nova conclusão criada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckinResult"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-Habit-Date",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "description": "Data exibida pelo dashboard. Se divergir do dia atual em São Paulo, retorna 409 day_changed sem gravar. Ausente: usa o dia atual do servidor."
          }
        ],
        "description": "Idempotente. Remove a conclusão de hoje, zera a quantidade e recalcula XP e conquistas na mesma transação. Não remove dias anteriores. Rejeita hábito arquivado e data desatualizada."
      }
    },
    "/habits/{habit_id}/checkins": {
      "parameters": [
        {
          "name": "habit_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
