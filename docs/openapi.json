      "patch": {
        "summary": "Editar dados do hábito",
        "operationId": "patch_habits_habit_id",
        "responses": {
          "200": {
            "description": "Editar dados do hábito",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Habit"
                }
              }
            }
          },
          "404": {
            "description": "Hábito não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Campos inválidos; meta semanal imutável.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Banco indisponível; error.code = database_unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado; mensagem genérica, detalhes apenas no log local.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "JSON malformado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Corpo maior que 16384 bytes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type inadequado; envie application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HabitUpdate"
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Excluir permanentemente hábito arquivado",
        "operationId": "delete_habits_habit_id",
        "description": "Remove em uma transação o hábito, suas quantidades diárias, realizações, eventos de XP e conquistas. XP total, nível e resumo passam a refletir apenas os hábitos restantes. Não exclui perfil nem dados de outros hábitos. Não há recuperação; um ID já excluído retorna 404.",
        "responses": {
          "200": {
            "description": "Hábito e todos os dados associados excluídos permanentemente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HabitDeleted"
                }
              }
            }
          },
          "404": {
            "description": "Hábito não encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Banco indisponível; error.code = database_unavailable.",
