              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado; mensagem genérica, detalhes apenas no log local.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Hábito ativo; error.code = habit_active. Arquive antes de excluir.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/habits/{habit_id}/archive": {
      "parameters": [
        {
          "name": "habit_id",
          "in": "path",
