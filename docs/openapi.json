{
  "openapi": "3.1.0",
  "info": {
    "title": "HabitQuest API",
    "version": "1.1.0",
    "description": "API acadêmica local, perfil único fixo e sem autenticação. Datas diárias em America/Sao_Paulo; instantes em UTC. Erros em JSON. CORS limitado à origem HABITQUEST_WEB_ORIGIN (padrão http://localhost:7357), com preflight automático; não representa autenticação."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5000/api/v1"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Verificar acesso ao banco",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "Verificar acesso ao banco",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Banco indisponível; error.code = database_unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado; mensagem genérica, detalhes apenas no log local.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/profile": {
      "get": {
        "summary": "Consultar perfil local fixo",
        "operationId": "get_profile",
        "responses": {
          "200": {
            "description": "Consultar perfil local fixo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado; mensagem genérica, detalhes apenas no log local.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Selecionar avatar do perfil local",
        "operationId": "patch_profile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "avatar": {
                    "type": "string",
                    "enum": [
                      "compass",
                      "leaf",
                      "flame"
                    ]
                  }
                },
                "required": [
                  "avatar"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Avatar persistido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "422": {
            "description": "Avatar ou campos inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "JSON inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Envie application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Banco indisponível.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/habits": {
      "get": {
        "summary": "Listar hábitos",
        "operationId": "get_habits",
        "responses": {
          "200": {
            "description": "Listar hábitos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Habit"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Filtro status inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Banco indisponível; error.code = database_unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado; mensagem genérica, detalhes apenas no log local.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "archived",
                "all"
              ],
              "default": "active"
            }
          }
        ]
      },
      "post": {
        "summary": "Criar hábito",
        "operationId": "post_habits",
        "responses": {
          "201": {
            "description": "Criar hábito",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Habit"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Caminho relativo /api/v1/habits/{id} do hábito criado.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Campos inválidos ou protegidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Banco indisponível; error.code = database_unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro inesperado; mensagem genérica, detalhes apenas no log local.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "JSON malformado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Corpo maior que 16384 bytes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type inadequado; envie application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HabitCreate"
              }
            }
          }
        }
      }
    },
